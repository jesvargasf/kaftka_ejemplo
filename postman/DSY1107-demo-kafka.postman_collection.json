  },
  "item": [
    {
      "name": "Pedido de Juan",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"Juan\",\n  \"monto\": 100\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:8888/pedidos",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8888",
          "path": ["pedidos"]
        },
        "description": "La clave es Juan. Vuelve a enviarlo: la particion de la consola no cambia y el offset sube."
